<Page x:Class="Lunaticn.Views.LobbyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Style="{StaticResource PageStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="联机大厅" FontSize="24" FontWeight="Bold" Foreground="White" />
                <ProgressBar x:Name="LoadingRing" Width="16" Height="16" Margin="10,0,0,0"
                             IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新" Click="Refresh_Click" Padding="14,7" Margin="0,0,8,0" />
                <Button Style="{StaticResource BrandButtonStyle}"
                        Content="创建房间" Click="CreateRoom_Click" />
            </StackPanel>
        </Grid>

        <!-- 页签 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="TabRooms" Content="玩家房间" IsChecked="True"
                         Checked="Tab_Checked" Foreground="White" Margin="0,0,16,0" />
            <RadioButton x:Name="TabServers" Content="官方服务器"
                         Checked="Tab_Checked" Foreground="White" />
        </StackPanel>

        <!-- 状态 -->
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#FF7A8699" FontSize="12"
                   Margin="0,0,0,8" />

        <!-- 房间/服务器列表 -->
        <Grid Grid.Row="3">
            <Grid x:Name="RoomsPane">
                <ListView x:Name="RoomList" SelectionMode="None"
                          ItemContainerStyle="{StaticResource CardListView}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80B;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#FF00B8A9"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="White" Margin="6,0,0,0" />
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="#FFB79C0F"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Visibility="{Binding HasPassword,
                                                       Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="#FF7A8699"
                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Foreground="#FF7A8699" FontSize="12" Margin="0,0,12,0"
                                           Text="{Binding World}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Foreground="#FF7A8699" FontSize="12" Margin="0,0,12,0"
                                           Text="{Binding Players}" />
                                <Button Grid.Column="3" Content="进入" Click="JoinRoom_Click"
                                        CommandParameter="{Binding}" Padding="12,6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView x:Name="ServerList" SelectionMode="None" Visibility="Collapsed"
                          ItemContainerStyle="{StaticResource CardListView}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Foreground="#FF7A8699" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="{Binding Port}" />
                                <Button Grid.Column="2" Content="进入" Click="JoinServer_Click"
                                        CommandParameter="{Binding}" Padding="12,6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHint"
                           Text="暂无房间。点击“创建房间”开一局，或等待其他玩家开房。"
                           Foreground="#FF7A8699" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- 我的开房状态 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Visibility="Collapsed"
                x:Name="HostCard" Margin="0,12,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="我的房间" Foreground="#FF7A8699" />
                        <TextBlock x:Name="HostStateText" Foreground="#FF00B8A9" Margin="8,0,0,0" />
                        <TextBlock x:Name="HostPlayersText" Foreground="#FF7A8699" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Content="结束房间" HorizontalAlignment="Right" Click="StopHost_Click"
                            Padding="12,6" />
                </Grid>
                <ScrollViewer MaxHeight="140">
                    <TextBlock x:Name="HostLogText" Foreground="#FF5C6B7F"
                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
