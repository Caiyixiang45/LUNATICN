<Page x:Class="Lunaticn.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Style="{StaticResource PageStyle}">

    <Grid Margin="24" MaxWidth="720" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="24" FontWeight="Bold" Foreground="White"
                   Margin="0,0,0,16" />

        <!-- 社区服务器 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="社区服务器" FontWeight="SemiBold" Foreground="White"
                           FontSize="15" Margin="0,0,0,8" />
                <TextBlock Text="服务器地址" Foreground="#FF7A8699" FontSize="12" />
                <TextBox x:Name="ServerUrlBox" Padding="8,6" Margin="0,4,0,8"
                         Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                         CaretBrush="White" ToolTip="http://127.0.0.1:8080" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存并测试" Style="{StaticResource BrandButtonStyle}"
                            Click="SaveServer_Click" Margin="0,0,8,0" />
                    <Button Content="退出登录" Click="Logout_Click" Margin="0,0,8,0"
                            Padding="14,7" />
                    <TextBlock x:Name="AccountText" Foreground="#FF7A8699"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 引擎 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="游戏引擎" FontWeight="SemiBold" Foreground="White"
                           FontSize="15" Margin="0,0,0,8" />
                <TextBlock x:Name="EngineInfoText" Foreground="#FF7A8699" FontSize="12"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="检查更新" Click="CheckEngine_Click" Margin="0,0,8,0"
                            Padding="14,7" />
                    <Button Content="重新下载" Click="ReinstallEngine_Click" Margin="0,0,8,0"
                            Padding="14,7" />
                    <ProgressBar x:Name="EngineProgress" Width="180" Height="4"
                                 VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="EngineStatusText" Foreground="#FF00B8A9" FontSize="12"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- 联机 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="联机" FontWeight="SemiBold" Foreground="White" FontSize="15"
                           Margin="0,0,0,8" />
                <TextBlock Text="游戏内昵称" Foreground="#FF7A8699" FontSize="12" />
                <TextBox x:Name="PlayerNameBox" Padding="8,6" Margin="0,4,0,8"
                         Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                         CaretBrush="White" ToolTip="进入服务器时显示的名字" />
                <TextBlock Text="客户端端口（0=随机）" Foreground="#FF7A8699" FontSize="12" />
                <TextBox x:Name="ClientPortBox" Padding="8,6" Margin="0,4,0,8"
                         Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                         CaretBrush="White" />
                <Button Content="保存联机设置" Click="SaveNet_Click" HorizontalAlignment="Left"
                        Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 目录 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="目录" FontWeight="SemiBold" Foreground="White" FontSize="15"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="DirsText" Foreground="#FF7A8699" FontSize="12"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="打开存档目录" Click="OpenWorlds_Click" Margin="0,0,8,0"
                            Padding="14,7" />
                    <Button Content="打开模组目录" Click="OpenMods_Click" Padding="14,7" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 关于 -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="关于" FontWeight="SemiBold" Foreground="White" FontSize="15"
                           Margin="0,0,0,4" />
                <TextBlock Foreground="#FF7A8699" FontSize="12" TextWrapping="Wrap"
                           Text="LUNATICN 启动器 · 基于 Luanti 引擎二次封装" />
                <TextBlock x:Name="AboutText" Foreground="#FF5C6B7F" FontSize="11" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="6" x:Name="StatusText" Foreground="#FF7A8699" FontSize="12" />
    </Grid>
</Page>
