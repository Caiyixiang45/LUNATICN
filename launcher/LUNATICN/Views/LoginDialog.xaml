<Window x:Class="Lunaticn.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 LUNATICN"
        Width="420"
        SizeToContent="SizeToContent.Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource PageBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="登录 LUNATICN" FontSize="18" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,8" />
        <TextBlock x:Name="HintText" Foreground="#FF00B8A9" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="使用社区账号登录，即可开房、加好友、上传分享作品。" />

        <TextBlock Text="用户名" Foreground="#FF7A8699" FontSize="12" />
        <TextBox x:Name="UsernameBox" Padding="8,6" Margin="0,4,0,8"
                 Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                 CaretBrush="White" ToolTip="3-24 位小写字母/数字" />

        <TextBlock Text="密码" Foreground="#FF7A8699" FontSize="12" />
        <PasswordBox x:Name="PasswordBox1" Padding="8,6" Margin="0,4,0,8"
                     Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                     CaretBrush="White" ToolTip="至少 6 位" />

        <StackPanel x:Name="NickPanel" Visibility="Collapsed">
            <TextBlock Text="昵称" Foreground="#FF7A8699" FontSize="12" />
            <TextBox x:Name="NicknameBox" Padding="8,6" Margin="0,4,0,8"
                     Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                     CaretBrush="White" ToolTip="展示用，可留空" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#FFE74C3C" TextWrapping="Wrap"
                   Margin="0,0,0,8" Text="" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryBtn" Content="注册" Click="Secondary_Click"
                    MinWidth="84" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click"
                    MinWidth="84" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="PrimaryBtn" Content="登录" Click="Primary_Click"
                    MinWidth="84" Padding="12,6" Style="{StaticResource BrandButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
