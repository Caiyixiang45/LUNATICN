<Page x:Class="Lunaticn.Views.WorkshopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Style="{StaticResource PageStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="分享工坊" FontSize="24" FontWeight="Bold" Foreground="White" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="我的作品" Click="Mine_Click" Padding="14,7" />
            </StackPanel>
        </Grid>

        <!-- 搜索行 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TypeBox" Grid.Column="0" Width="120" Padding="8,6"
                      Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                      SelectedIndex="0">
                <ComboBoxItem Tag="" Content="全部" />
                <ComboBoxItem Tag="map" Content="地图" />
                <ComboBoxItem Tag="mod" Content="模组" />
            </ComboBox>
            <TextBox x:Name="QueryBox" Grid.Column="2" Padding="8,6"
                     Background="#FF14181F" Foreground="White" BorderBrush="#FF2A3342"
                     CaretBrush="White" ToolTip="搜索名称或简介…"
                     KeyDown="Query_KeyDown" />
            <Button Grid.Column="4" Content="搜索" Style="{StaticResource BrandButtonStyle}"
                    Click="Search_Click" />
        </Grid>

        <!-- 结果列表 -->
        <ListView Grid.Row="3" x:Name="PackageList" SelectionMode="None"
                  ItemContainerStyle="{StaticResource CardListView}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="54" CornerRadius="4"
                                    Background="#FF252C38">
                                <TextBlock Text="&#xE83E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Foreground="#FF00B8A9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="White" FontSize="15" />
                                    <Border Background="#FF00B8A9" CornerRadius="3"
                                            Padding="6,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="10" Foreground="White"
                                                   Text="{Binding Type}" />
                                    </Border>
                                    <TextBlock Text="{Binding Version}" Foreground="#FF7A8699"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="#FF7A8699"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Foreground="#FF5C6B7F" FontSize="11"
                                               Text="{Binding AuthorName}" />
                                    <TextBlock Foreground="#FF5C6B7F" FontSize="11" Margin="12,0,0,0">
                                        <Run Text="下载 " /><Run Text="{Binding Downloads}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="下载" Click="Download_Click"
                                        CommandParameter="{Binding}" Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="删除" Click="DeletePackage_Click"
                                        CommandParameter="{Binding}" Padding="12,6" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="#FF7A8699" FontSize="12"
                   Margin="0,8,0,0" />
    </Grid>
</Page>
