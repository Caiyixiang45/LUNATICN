<Page x:Class="Lunaticn.Views.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Style="{StaticResource PageStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="模组中心" FontSize="24" FontWeight="Bold" Foreground="White" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导入模组" Click="Import_Click" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="刷新" Click="Refresh_Click" Padding="14,7" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="ModList" SelectionMode="None"
                      ItemContainerStyle="{StaticResource CardListView}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="White" FontSize="15" />
                                        <TextBlock Text="{Binding Name}" Foreground="#FF00B8A9"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Version}" Foreground="#FF7A8699"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="#FF7A8699"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0" />
                                    <TextBlock Foreground="#FFB79C0F" FontSize="11"
                                               Text="{Binding DependsSummary}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="配置到存档" Click="Assign_Click"
                                            CommandParameter="{Binding}" Padding="12,6"
                                            Margin="0,0,8,0" />
                                    <Button Content="卸载" Click="Uninstall_Click"
                                            CommandParameter="{Binding}" Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint" Text="模组库为空。点“导入模组”或去分享工坊下载。"
                       Foreground="#FF7A8699" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#FF7A8699" FontSize="12"
                   Margin="0,8,0,0" />
    </Grid>
</Page>
