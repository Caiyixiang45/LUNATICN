<Page x:Class="Lunaticn.Views.WorldsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Style="{StaticResource PageStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="存档库" FontSize="24" FontWeight="Bold" Foreground="White" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导入存档" Click="Import_Click" Padding="14,7" Margin="0,0,8,0" />
                <Button Style="{StaticResource BrandButtonStyle}"
                        Content="新建存档" Click="Create_Click" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" x:Name="WorldList" SelectionMode="None"
                  ItemContainerStyle="{StaticResource CardListView}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="96" Height="64" CornerRadius="4"
                                    Background="#FF252C38" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="White" FontSize="15" />
                                    <TextBlock Text="{Binding GameId}" Foreground="#FF00B8A9"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                    <TextBlock Text="创造" FontSize="11"
                                               Foreground="#FFB79C0F" VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding Creative,
                                                   Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Foreground="#FF7A8699" FontSize="12">
                                        <Run Text="模组 " /><Run Text="{Binding EnabledMods.Count}" />
                                    </TextBlock>
                                    <TextBlock Foreground="#FF7A8699" FontSize="12"
                                               Text="{Binding LastPlayed}" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="进入" Click="Play_Click"
                                        CommandParameter="{Binding}" Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="复制" Click="Copy_Click"
                                        CommandParameter="{Binding}" Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="分享" Click="Share_Click"
                                        CommandParameter="{Binding}" Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="删除" Click="Delete_Click"
                                        CommandParameter="{Binding}" Padding="12,6" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" x:Name="EmptyHint" Text="还没有存档，点右上角“新建存档”开始。"
                   Foreground="#FF7A8699" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#FF7A8699" FontSize="12"
                   Margin="0,8,0,0" />
    </Grid>
</Page>
